vendor/
# `bin/` is ignored wholesale except for what the package actually ships: the
# entry is a directory, so a bare `!bin/x` would never be reconsidered.
/bin/*
!/bin/package-toolkit-ai
.idea/
composer.lock
/cov.html/
build/
node_modules/
package-lock.json
.DS_Store
--cache-directory/
.claude/settings.local.json

# Documentation site
# The lockfile is kept so the Pages workflow can `npm ci` against pinned versions.
!site/package-lock.json
site/dist/
site/.torchlight-cache/
.playwright-mcp/
